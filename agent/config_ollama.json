{
    "name": "CUA_RAG_Agent_Ollama",
    "version": "1.0.0",
    "platform": "windows",
    "max_attempts": 1,
    "max_grounding_attempts": 3,
    "max_steps": 30,
    "max_wall_time": 2000,
    "step_interval_time": 0.5,
    "env": {
        "name": "windows_env",
        "platform": "windows",
        "url": "localhost",
        "screen_height": null,
        "screen_width": null,
        "observation_type": "screenshot_a11y_tree",
        "observe_screenshot_in_bytes": true,
        "a11y_tree_max_tokens": 1000
    },
    "mixture_grounding": {
        "expertises": [
            {
                "model": "uia_desktop_grounding",
                "weight": 1.0,
                "endpoint_url": "http://127.0.0.1:11434",
                "model_name": "qwen2.5vl-vision"
            },
            {
                "model": "ollama_grounding",
                "weight": 1.0,
                "endpoint_url": "http://127.0.0.1:11434",
                "model_name": "qwen2.5vl-vision"
            },
            {
                "model": "uia_tree",
                "weight": 0.0
            }
        ]
    },
    "planner": {
        "model_class": "ollama",
        "expertises": {
            "ollama": {
                "model_name": "qwen2.5vl-vision",
                "api_base": "http://127.0.0.1:11434"
            }
        }
    },
    "rag": {
        "rel_index_dir": "asset/rag_index/actions",
        "rel_action_sample_path": "0percent",
        "model_name": "Qwen/Qwen3-Embedding-0.6B",
        "semantic_weight": 0.7
    },
    "logger": {
        "enable": true,
        "log_level_desc": "one of the following: [debug, info, warning, error, critical]",
        "log_level": "debug",
        "log_file": "log.jsonl",
        "log_dir": "./results/cua_logs",
        "record": true
    }
}
